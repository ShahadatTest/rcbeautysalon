# ===== Baza podatkov (PostgreSQL) =====
# Neon / Supabase / lokalni Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/beauty_salon"

# ===== NextAuth =====
# Ustvari z: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ===== Aplikacija =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Stripe (NEOBVEZNO) =====
# Priporočeno: admin vnese ključe v Nastavitve → Plačila (brez deploya).
# Ti ključi služijo le kot platformni fallback za salone brez svojih ključev.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===== Platformne naročnine (EPIC #3 E3-4, NEOBVEZNO) =====
# Ločen Stripe račun PLATFORME (najemniki → platforma tok denarja),
# popolnoma ločen od zgornjih per-tenant ključev (najemnik → njegove stranke).
# Brez teh ključev UI pošteno prikaže "setup required" — nič ni faked.
PLATFORM_STRIPE_SECRET_KEY=""
PLATFORM_STRIPE_WEBHOOK_SECRET=""
# Recurring price ids za plačljive pakete (Stripe Dashboard → Products).
# Webhook endpoint: /api/webhooks/platform-stripe
PLATFORM_STRIPE_PRICE_PRO=""
PLATFORM_STRIPE_PRICE_SCALE=""
